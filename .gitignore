# Python / editors
__pycache__/
*.pyc
*.swp

# The original game and everything made from it stay out of the
# repository: build.sh (recipe.json) remakes them from the user's own copy.
*.zip
*.adf
extracted/
game/
unpacked/
analysis/*.json

# The unpacker (tools/unpack.c, built)
tools/unpack

# Recompilation: generated C, objects, binaries, run outputs
recomp/gen*/
recomp/*.o
recomp/fireice
recomp/*.events
recomp/*.vdu
recomp/*.screen
recomp/*.regs
recomp/*.bmp
recomp/*.png
recomp/*.wav
recomp/vidc.log
recomp/untranslated.log
recomp/savedata/

# run outputs left by a run from tools/
tools/recomp.*
tools/vidc.log
